{
  "name": "baroflixdesktop",
  "version": "0.1.0",
  "author": "baro",
  "description": "Baroflix Desktop — Electron wrapper for baroflix.github.io",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build": "electron-builder"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.baro.baroflix",
    "publish": [
      {
        "provider": "github",
        "owner": "baroflix",
        "repo": "baroflix-desktop"
      }
    ],
    "productName": "Baroflix",
    "copyright": "Copyright © 2025 baro",
    "files": [
      "index.js",
      "preload.js",
      "settings.html",
      "titlebar.html",
      "splash.html",
      "build/**",
      "images/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon2.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/512.icns"
    },
    "linux": {
      "target": "tar.gz",
      "icon": "build/icon2.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon2.ico"
    }
  }
}